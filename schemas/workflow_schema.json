{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://livekit.io/schemas/workflow-agent.json",
	"title": "Workflow Agent Configuration",
	"description": "Schema for LiveKit workflow-based agent configurations with node handoffs and specialized agents",
	"type": "object",
	"required": ["id", "name", "version", "entry_node_id", "nodes"],
	"properties": {
		"id": {
			"type": "string",
			"description": "Unique identifier for this workflow configuration",
			"pattern": "^[a-z0-9-]+$",
			"examples": ["customer-support-workflow", "restaurant-ordering-v1"]
		},
		"name": {
			"type": "string",
			"description": "Human-readable name for the workflow",
			"minLength": 1,
			"examples": ["Customer Support Workflow", "Restaurant Ordering System"]
		},
		"version": {
			"type": "string",
			"description": "Version number for tracking configuration changes",
			"pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
			"examples": ["1.0", "2.1.3"]
		},
		"description": {
			"type": "string",
			"description": "Detailed description of workflow purpose and capabilities"
		},
		"entry_node_id": {
			"type": "string",
			"description": "ID of the node where workflow execution begins",
			"examples": ["welcome", "greeting", "initial_router"]
		},
		"global_tools": {
			"type": "array",
			"description": "Tools available to all nodes in the workflow",
			"items": {
				"type": "string"
			},
			"default": []
		},
		"nodes": {
			"type": "array",
			"description": "Array of workflow nodes with specific agent behaviors",
			"minItems": 1,
			"items": {
				"$ref": "#/definitions/WorkflowNode"
			}
		}
	},
	"definitions": {
		"WorkflowNode": {
			"type": "object",
			"required": ["id", "type", "name", "prompt", "transitions"],
			"properties": {
				"id": {
					"type": "string",
					"description": "Unique identifier for this node",
					"pattern": "^[a-z0-9_]+$",
					"examples": ["welcome", "billing_support", "order_confirmation"]
				},
				"type": {
					"type": "string",
					"description": "Type of workflow node defining its behavior",
					"enum": ["welcome", "conversational", "transition", "tool", "hangup"],
					"examples": ["welcome", "conversational"]
				},
				"name": {
					"type": "string",
					"description": "Human-readable name for the node",
					"minLength": 1
				},
				"description": {
					"type": "string",
					"description": "Detailed explanation of node's purpose in the workflow"
				},
				"prompt": {
					"$ref": "#/definitions/WorkflowPrompt",
					"description": "Prompt configuration for this node's agent"
				},
				"tools": {
					"type": "array",
					"description": "Tools available specifically to this node",
					"items": {
						"type": "string"
					},
					"default": []
				},
				"transitions": {
					"type": "array",
					"description": "Possible handoffs from this node to other nodes",
					"items": {
						"$ref": "#/definitions/WorkflowTransition"
					}
				},
				"preserve_chat_context": {
					"type": "boolean",
					"description": "Whether to preserve conversation history when transitioning to this node",
					"default": true
				}
			}
		},
		"WorkflowPrompt": {
			"type": "object",
			"required": ["system_prompt", "instructions"],
			"properties": {
				"system_prompt": {
					"type": "string",
					"description": "System-level instructions defining agent personality and role",
					"minLength": 1
				},
				"instructions": {
					"type": "string",
					"description": "Specific instructions for this node's behavior and tasks",
					"minLength": 1
				},
				"max_tokens": {
					"type": "integer",
					"description": "Maximum tokens for agent response",
					"minimum": 1,
					"maximum": 4096,
					"default": 150
				},
				"temperature": {
					"type": "number",
					"description": "LLM temperature controlling response creativity (0.0-1.0)",
					"minimum": 0,
					"maximum": 1,
					"default": 0.7
				}
			}
		},
		"WorkflowTransition": {
			"type": "object",
			"required": ["target_node_id", "condition"],
			"properties": {
				"target_node_id": {
					"type": "string",
					"description": "ID of the node to hand off to when condition is met"
				},
				"condition": {
					"$ref": "#/definitions/WorkflowCondition",
					"description": "Condition triggering the handoff"
				},
				"priority": {
					"type": "integer",
					"description": "Priority for evaluating this transition (higher = checked first)",
					"minimum": 1,
					"default": 5
				}
			}
		},
		"WorkflowCondition": {
			"type": "object",
			"required": ["type"],
			"properties": {
				"type": {
					"type": "string",
					"description": "Type of condition evaluation",
					"enum": ["intent", "regex", "exact", "always"]
				},
				"intent_description": {
					"type": "string",
					"description": "Natural language description of user intent (for intent type)",
					"examples": [
						"Customer needs help with billing or payments",
						"User wants to place an order",
						"Customer is satisfied and wants to end the call"
					]
				},
				"pattern": {
					"type": "string",
					"description": "Regex pattern to match user input (for regex type)",
					"examples": [
						"(?i)(billing|payment|invoice)",
						"(?i)(bye|goodbye|thanks)"
					]
				},
				"text": {
					"type": "string",
					"description": "Exact text to match (for exact type)"
				}
			},
			"oneOf": [
				{
					"properties": {
						"type": {
							"const": "intent"
						}
					},
					"required": ["intent_description"]
				},
				{
					"properties": {
						"type": {
							"const": "regex"
						}
					},
					"required": ["pattern"]
				},
				{
					"properties": {
						"type": {
							"const": "exact"
						}
					},
					"required": ["text"]
				},
				{
					"properties": {
						"type": {
							"const": "always"
						}
					}
				}
			]
		}
	}
}
