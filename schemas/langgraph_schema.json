{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://livekit.io/schemas/langgraph-agent.json",
	"title": "LangGraph Agent Configuration",
	"description": "Schema for LiveKit LangGraph-based agent configurations with state machine orchestration and conditional routing",
	"type": "object",
	"required": ["id", "name", "version", "entry_node", "nodes"],
	"properties": {
		"id": {
			"type": "string",
			"description": "Unique identifier for this graph configuration",
			"pattern": "^[a-z0-9-]+$",
			"examples": ["customer-support-graph", "restaurant-ordering-graph-v1"]
		},
		"name": {
			"type": "string",
			"description": "Human-readable name for the graph",
			"minLength": 1,
			"examples": ["Customer Support LangGraph", "Restaurant Ordering System"]
		},
		"version": {
			"type": "string",
			"description": "Version number for tracking configuration changes",
			"pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
			"examples": ["1.0", "2.1.3"]
		},
		"description": {
			"type": "string",
			"description": "Detailed description of graph purpose and orchestration logic"
		},
		"entry_node": {
			"type": "string",
			"description": "ID of the node where graph execution begins",
			"examples": ["welcome", "router", "entry_point"]
		},
		"end_node": {
			"type": "string",
			"description": "Special node marking graph termination",
			"default": "__end__"
		},
		"nodes": {
			"type": "array",
			"description": "Array of graph nodes representing conversation states",
			"minItems": 1,
			"items": {
				"$ref": "#/definitions/GraphNode"
			}
		},
		"edges": {
			"type": "array",
			"description": "Direct edges between nodes (unconditional transitions)",
			"items": {
				"type": "array",
				"description": "Tuple of [source_node_id, target_node_id]",
				"minItems": 2,
				"maxItems": 2,
				"items": {
					"type": "string"
				}
			},
			"examples": [
				["billing_agent", "satisfaction_check"],
				["order_node", "confirmation"]
			]
		},
		"conditional_edges": {
			"type": "array",
			"description": "Conditional edges with dynamic routing based on state",
			"items": {
				"$ref": "#/definitions/ConditionalEdge"
			}
		}
	},
	"definitions": {
		"GraphNode": {
			"type": "object",
			"required": ["id", "name", "type", "system_prompt", "prompt_template"],
			"properties": {
				"id": {
					"type": "string",
					"description": "Unique identifier for this graph node",
					"pattern": "^[a-z0-9_]+$",
					"examples": ["welcome", "billing_agent", "order_router"]
				},
				"name": {
					"type": "string",
					"description": "Human-readable name for the node",
					"minLength": 1
				},
				"description": {
					"type": "string",
					"description": "Detailed explanation of node's role in the graph"
				},
				"type": {
					"type": "string",
					"description": "Type of graph node defining its behavior",
					"enum": [
						"router",
						"conversational",
						"tool",
						"hangup",
						"state_update"
					],
					"examples": ["router", "conversational"]
				},
				"system_prompt": {
					"type": "string",
					"description": "System-level instructions for agent behavior in this node",
					"minLength": 1
				},
				"prompt_template": {
					"type": "string",
					"description": "Prompt template for agent responses (can use state variables)",
					"minLength": 1
				},
				"max_tokens": {
					"type": "integer",
					"description": "Maximum tokens for agent response",
					"minimum": 1,
					"maximum": 4096,
					"default": 150
				},
				"temperature": {
					"type": "number",
					"description": "LLM temperature controlling response randomness (0.0-1.0)",
					"minimum": 0,
					"maximum": 1,
					"default": 0.7
				},
				"tools": {
					"type": "array",
					"description": "Tools available to this specific node",
					"items": {
						"type": "string"
					},
					"default": []
				},
				"preserve_context": {
					"type": "boolean",
					"description": "Whether to maintain conversation history at this node",
					"default": true
				}
			}
		},
		"ConditionalEdge": {
			"type": "object",
			"required": ["source", "condition", "targets"],
			"properties": {
				"source": {
					"type": "string",
					"description": "ID of the source node where routing decision is made"
				},
				"condition": {
					"type": "string",
					"description": "Routing condition type or function name",
					"enum": [
						"route_by_intent",
						"route_by_satisfaction",
						"route_by_state",
						"custom"
					],
					"examples": ["route_by_intent", "route_by_satisfaction"]
				},
				"targets": {
					"type": "object",
					"description": "Mapping of condition outcomes to target node IDs",
					"additionalProperties": {
						"type": "string"
					},
					"examples": [
						{
							"billing": "billing_agent",
							"technical": "technical_agent",
							"general": "general_agent"
						},
						{
							"satisfied": "hangup",
							"more_help": "welcome"
						}
					]
				},
				"default": {
					"type": "string",
					"description": "Default target node if no condition matches"
				}
			}
		}
	},
	"examples": [
		{
			"id": "simple-support-graph",
			"name": "Simple Support Graph",
			"version": "1.0",
			"description": "Basic customer support with routing",
			"entry_node": "welcome",
			"end_node": "__end__",
			"nodes": [
				{
					"id": "welcome",
					"name": "Welcome Router",
					"type": "router",
					"system_prompt": "You are a friendly customer service representative.",
					"prompt_template": "Welcome! How can I help you today?",
					"max_tokens": 150,
					"temperature": 0.7,
					"tools": [],
					"preserve_context": false
				},
				{
					"id": "support_agent",
					"name": "Support Agent",
					"type": "conversational",
					"system_prompt": "You are a helpful support specialist.",
					"prompt_template": "I'm here to help. What's your concern?",
					"max_tokens": 200,
					"temperature": 0.6,
					"tools": ["check_status", "create_ticket"],
					"preserve_context": true
				},
				{
					"id": "hangup",
					"name": "End Call",
					"type": "hangup",
					"system_prompt": "End the call professionally.",
					"prompt_template": "Thank you for contacting us!",
					"max_tokens": 100,
					"temperature": 0.7,
					"tools": [],
					"preserve_context": false
				}
			],
			"edges": [["support_agent", "hangup"]],
			"conditional_edges": [
				{
					"source": "welcome",
					"condition": "route_by_intent",
					"targets": {
						"support": "support_agent",
						"hangup": "hangup"
					},
					"default": "support_agent"
				}
			]
		}
	]
}
